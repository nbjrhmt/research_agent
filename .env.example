# ==================== 本地个人调研 Agent —— 环境变量配置示例 ====================
# 用法:
#   1) 复制本文件为 .env(本项目 .env 不会入库, 请自行创建);
#      Windows:  copy .env.example .env
#      macOS/Linux: cp .env.example .env
#   2) 把下面各项占位内容替换为你的真实密钥。
# 注意: .env 内含密钥, 切勿提交到代码仓库或分享给他人。

# ── 必填: LLM 配置(OpenAI 及一切 OpenAI 兼容服务均可, 本项目示例为 DeepSeek) ──
# API Key(在对应服务商控制台申请)
OPENAI_API_KEY=sk-你的OpenAI兼容API_Key

# 接口地址(OpenAI 官方: https://api.openai.com/v1 可省略本行)
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 使用的模型名(按服务商提供的模型名填写, 例如 deepseek-chat / gpt-4o-mini)
LLM_MODEL=deepseek-chat

# ── 必填: 博查(Bocha)联网搜索配置(console.bochaai.com 申请) ──
BOCHA_API_KEY=sk-你的博查API_Key

# ── 以下为可选配置(不填使用默认值) ──
# BOCHA_BASE_URL=https://api.bocha.cn/v1/web-search   # 博查接口地址(默认即可)
# BOCHA_COUNT=5                                        # 单次搜索返回条数 1-10
# BOCHA_FRESHNESS=noLimit                              # 时效过滤: oneDay/oneWeek/oneMonth/oneYear/noLimit
# SEARCH_TIMEOUT=15                                    # 单次搜索超时秒数
